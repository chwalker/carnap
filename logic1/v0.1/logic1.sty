% {\sim} gives the swung dash

\def\ebot{\ensuremath{\bot}}                   % falsum
\def\etop{\ensuremath{\top}}                   % verum

\def\eexists{\ensuremath{\exists}}
\def\eforall{\ensuremath{\forall}}

\def\ealpha{\ensuremath{\alpha}\xspace}
\def\ebeta{\ensuremath{\beta}\xspace}
\def\egamma{\ensuremath{\gamma}\xspace}
\def\edelta{\ensuremath{\delta}\xspace}
\def\ezeta{\ensuremath{\zeta}\xspace}

\def\ephi{\ensuremath{\phi}\xspace}
\def\epsi{\ensuremath{\psi}\xspace}
\def\echi{\ensuremath{\chi}\xspace}

\def\eGamma{\ensuremath{\Gamma}\xspace}
\def\eDelta{\ensuremath{\Delta}\xspace}


\theoremstyle{definition}
\newtheorem{definition}{Definition}[section]
\newtheorem{example}[definition]{Example}

\newtheoremstyle{fitchdef} % name
                {12pt}     % Space above
                {3pt}      % Space below
                {}         % Body font
                {}         % Indent amount
                {\bfseries}% Head font
                {:}        % Punctuation after head
                { }        % Space after head
                {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}} % Head
                
\theoremstyle{fitchdef}
\newtheorem{fitchrule}{Rule}[section]

\newlist{argument}{itemize}{1}
\setlist[argument]{itemsep=0pt, parsep=0pt, topsep=10pt}

\newcommand{\twoitems}[2]{%
\noindent
\begin{minipage}{0.5\textwidth}\centering #1\end{minipage}%
\begin{minipage}{0.5\textwidth}\centering #2\end{minipage}
}

\newcommand{\threeitems}[3]{%
\noindent
\begin{minipage}{0.33\textwidth}\centering #1\end{minipage}%
\begin{minipage}{0.33\textwidth}\centering #2\end{minipage}%
\begin{minipage}{0.33\textwidth}\centering #3\end{minipage}%
}
