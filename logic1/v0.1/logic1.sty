\usepackage{tikz}
\usetikzlibrary{arrows.meta, positioning}

\setlength{\parskip}{1em}
\setlength{\parindent}{0pt}

\def\therefore{\ensuremath{\ldotp\dot{}\,\ldotp}}    % therefore
\def\efollows{\ensuremath{\vdash}\xspace}            % turnstyle 
\def\enotfollows{\ensuremath{\not\vdash}\xspace} % not turnstyle 
\def\eentails{\ensuremath{\vDash}\xspace}            % entails 
\def\enotentails{\ensuremath{\nvDash}\xspace}        % does not entail

\def\esubset{\ensuremath{\subset}\xspace}      % subset

\def\eor{\ensuremath{\vee}\xspace}             % disjunction
\def\eand{\ensuremath{\wedge}\xspace}          % conjunction
\def\eif{\ensuremath{\rightarrow}\xspace}      % conditional
\def\eiff{\ensuremath{\leftrightarrow}\xspace} % biconditional
\def\enot{\ensuremath{\neg}}                   % negation

